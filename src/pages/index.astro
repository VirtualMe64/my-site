---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Cover from '../components/Cover.astro'
import About from '../components/About.astro'
import Experience from '../components/Experience.astro'
import Projects from '../components/Projects.astro'
import Contact from '../components/Contact.astro'
import Footer from '../components/Footer.astro'

const description = 'Software Engineer at Stripe, helping agents pay for things.'
const ogImage = 'https://staubman.vercel.app/og-image.png'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sammy Taubman</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter (link previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sammy Taubman" />
    <meta property="og:url" content="https://staubman.vercel.app/" />
    <meta property="og:title" content="Sammy Taubman" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sammy Taubman" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Figtree: print; Architects Daughter: red marker; Sacramento: signature -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Figtree:wght@400;500;600;700&family=Sacramento&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- shared by every .ink drawing: a slight displacement so strokes wobble
         like pen on paper instead of reading as vector-perfect -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="wobble" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" /><feDisplacementMap in="SourceGraphic" scale="1.6" /></filter>
    </svg>

    <Nav />
    <main>
      <Cover />
      <About />
      <Experience />
      <Projects />
      <Contact />
    </main>
    <Footer />
  </body>
</html>
