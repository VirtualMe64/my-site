---
// Small red line drawings for project cards, keyed by name. Decorative.
const { name } = Astro.props
---

<svg class="doodle" viewBox="0 0 64 56" aria-hidden="true">
  <g class="ink">
    {name === 'chip' && <><rect x="18" y="14" width="28" height="28" rx="3" /><rect x="26" y="22" width="12" height="12" rx="1" /><path d="M24 14V7M32 14V7M40 14V7M24 42v7M32 42v7M40 42v7M18 22h-7M18 30h-7M46 22h7M46 30h7" /></>}
    {name === 'slides' && <><rect x="8" y="10" width="44" height="30" rx="2" /><path d="M30 40v8M22 50l8-2 8 2M15 20h18M15 27h28M15 33h12" /><path d="M54 6l2 5 5 1-5 2-2 5-1-5-5-2 5-1z" /></>}
    {name === 'scatter' && <><path d="M10 8v38h46" /><circle cx="20" cy="36" r="2" /><circle cx="26" cy="30" r="2" /><circle cx="22" cy="26" r="2" /><circle cx="38" cy="20" r="2" /><circle cx="44" cy="16" r="2" /><circle cx="42" cy="24" r="2" /><circle cx="48" cy="34" r="2" /><path d="M16 22c4-6 14-2 12 8M34 12c8-4 16 2 12 14" stroke-dasharray="2 3" /></>}
    {name === 'soccer' && <><circle cx="32" cy="28" r="20" /><path d="M32 20l7 5-3 8h-8l-3-8zM32 20v-12M39 25l11-4M36 33l7 10M28 33l-7 10M25 25l-11-4" /></>}
    {name === 'quill' && <><path d="M48 6C30 10 20 26 16 46M48 6C46 22 36 34 20 40M30 26l-6 2" /><path d="M14 50h34" /></>}
    {name === 'stopwatch' && <><circle cx="32" cy="31" r="18" /><path d="M32 31V20M32 31l7 5M28 9h8M32 9v4M47 15l3-3" /></>}
    {name === 'baseball' && <><path d="M12 48L42 12c3-3 7 1 4 4L16 50z" /><circle cx="48" cy="40" r="8" /><path d="M42 36c3 1 4 4 3 8M54 36c-3 1-4 4-3 8" /></>}
    {name === 'nodes' && <><rect x="6" y="8" width="16" height="11" rx="2" /><rect x="42" y="8" width="16" height="11" rx="2" /><rect x="24" y="38" width="16" height="11" rx="2" /><path d="M22 13.5h20M14 19c0 12 10 10 14 19M50 19c0 12-10 10-14 19" /></>}
  </g>
</svg>

<style>
  .doodle {
    display: block;
    width: 4.25rem;
    height: auto;
  }
</style>
