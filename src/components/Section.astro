---
// A dictionary-entry section: number, headword (interpunct dots split from
// the ·s in `word`, gold, hidden from screen readers), part of speech and
// gloss in a left column; the body on the right — an open-book spread.
const { id, word, pos, gloss, index } = Astro.props
const parts = word.split('·')
---

<section id={id} class="block">
  <div class="inner split">
    <header class="head">
      <p class="label">{String(index).padStart(2, '0')}</p>
      <h2 class="headword">{parts.map((part, i) => <>{i > 0 && <span class="dot" aria-hidden="true">·</span>}{part}</>)}</h2>
      <p class="gloss"><span class="pos">{pos}</span> {gloss}</p>
    </header>
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 3rem;
    align-items: start;
  }

  .head {
    position: sticky;
    top: 7rem;
  }

  .headword {
    margin-top: 1rem;
  }

  .gloss {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
  }

  .gloss .pos {
    margin-right: 0.3rem;
    font-size: 1.15em;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .head {
      position: static;
    }
  }
</style>
