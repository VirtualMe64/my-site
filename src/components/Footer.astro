---
const year = new Date().getFullYear()
---

<footer class="footer">
  <p>&copy; {year} Sammy Taubman</p>
  <p class="hand">thanks for scrolling!</p>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-rule);
    padding: 1.75rem var(--page-padding) 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
