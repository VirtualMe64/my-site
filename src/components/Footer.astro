---
import { words, scrabbleScore } from '../content/scrabble.js'

// The static HTML gets a deterministic fallback word (and the build-time
// year); the client script below swaps in the values for the visitor's date.
const fallback = words[0]
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="inner">
    <p class="wotd">
      <span class="label">Scrabble word of the day</span>
      <span class="word" data-word>{fallback.text}</span>
      <span class="score" data-score>{scrabbleScore(fallback.text)} pts</span>
      <span class="def" data-def>{fallback.def}</span>
    </p>
    <p class="label">&copy; <span data-year>{year}</span> Sammy Taubman</p>
  </div>
</footer>

<script>
  import { wordOfTheDay, scrabbleScore } from '../content/scrabble.js'

  const word = wordOfTheDay()
  document.querySelector('[data-word]').textContent = word.text
  document.querySelector('[data-score]').textContent = `${scrabbleScore(word.text)} pts`
  document.querySelector('[data-def]').textContent = word.def
  document.querySelector('[data-year]').textContent = String(new Date().getFullYear())
</script>

<style>
  .footer {
    border-top: 1px solid var(--color-rule);
    padding: 2.5rem var(--page-padding);
  }

  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
  }

  .wotd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
  }

  .word {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }

  .score {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .def {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }
</style>
