---
// The nav and the slide counter both derive from the sections list.
import { sections } from '../content/site.js'
const total = String(sections.length).padStart(2, '0')
---

<nav class="nav" aria-label="Primary">
  <div class="bar">
    <a class="logo" href="#home" aria-label="Home"><span class="full">sammy taubman</span><span class="short">sammy</span></a>
    <ul class="list">
      {sections.map((link, i) => (
        <li class:list={{ home: link.id === 'home' }}>
          <a
            href={`#${link.id}`}
            class:list={['link', { active: i === 0 }]}
            aria-current={i === 0 ? 'true' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<!-- carousel-style page counter: "[ 02 / 05 ]" -->
<p class="counter" aria-hidden="true"><span data-counter>01</span> / {total}</p>

<script>
  // Scroll-spy: the slide crossing the middle of the viewport is "current" —
  // it gets the nav's brackets and the counter's number.
  const links = [...document.querySelectorAll('nav[aria-label="Primary"] .list a[href^="#"]')]
  const counter = document.querySelector('[data-counter]')

  function setActive(id) {
    links.forEach((link, i) => {
      const active = link.getAttribute('href') === `#${id}`
      link.classList.toggle('active', active)
      if (active) {
        link.setAttribute('aria-current', 'true')
        counter.textContent = String(i + 1).padStart(2, '0')
      } else {
        link.removeAttribute('aria-current')
      }
    })
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive(entry.target.id)
      }
    },
    { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
  )

  for (const link of links) {
    const section = document.querySelector(link.getAttribute('href'))
    if (section) observer.observe(section)
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    max-width: calc(var(--content-width) + 2 * var(--page-padding));
    margin: 0 auto;
    padding: 0.5rem var(--page-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* the signature doubles as the logo. the nudge down lines the script's
     x-height up with the caps of the links (script fonts sit high) */
  .logo {
    font-family: var(--font-script);
    font-size: 1.85rem;
    line-height: 1;
    color: var(--color-accent);
    transform: translateY(2px);
    transition: opacity 0.2s ease;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .short {
    display: none;
  }

  .list {
    list-style: none;
    display: flex;
    gap: 0.4rem;
  }

  /* active link gets red brackets; they're always laid out (transparent
     at rest) so the row never shifts */
  .link {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .link::before,
  .link::after {
    color: transparent;
    transition: color 0.2s ease;
  }

  .link::before { content: '['; margin-right: 0.7em; }
  .link::after { content: ']'; margin-left: 0.7em; }

  .link:hover,
  .link:focus-visible {
    color: var(--color-accent);
  }

  .link.active::before,
  .link.active::after {
    color: var(--color-accent);
  }

  .counter {
    position: fixed;
    right: var(--page-padding);
    bottom: 1.25rem;
    z-index: 10;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .counter::before { content: '['; margin-right: 1.2em; }
  .counter::after { content: ']'; margin-left: 1.2em; }

  @media (max-width: 760px) {
    .full { display: none; }
    .short { display: inline; }
    .list .home { display: none; }
  }

  @media (max-width: 640px) {
    .logo {
      font-size: 1.6rem;
    }

    .list {
      gap: 0;
    }

    .link {
      font-size: 0.62rem;
      letter-spacing: 0.08em;
    }

    .link::before { margin-right: 0.4em; }
    .link::after { margin-left: 0.4em; }

    .counter {
      display: none;
    }
  }
</style>
