---
// The top bar, at every width: the rack logo (the home link) on the left,
// section links on the right. The links derive from the same sections list
// that drives the section headers, so the two can't fall out of sync.
import { sections } from '../content/site.js'
---

<nav class="nav" aria-label="Primary">
  <div class="bar">
    <!-- the rack mark is inlined rather than reusing the favicon <img>: the
         favicon's square viewBox has dead space above/below the tiles that
         would render it undersized, and inlining lets the tile rects fill
         with currentColor so the link can hover-shift gold → sage -->
    <a class="brand" href="#home" aria-label="Sammy Taubman, home">
      <svg viewBox="0 7.5 32 17.5" aria-hidden="true">
        <g transform="rotate(-5 8.25 15.75)">
          <rect x="1" y="8.5" width="14.5" height="14.5" rx="2.5" fill="currentColor"/>
          <text x="7.9" y="15.4" dominant-baseline="central" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="11" font-weight="700" fill="#162013">S</text>
          <text x="14.1" y="21.6" text-anchor="end" font-family="Georgia, 'Times New Roman', serif" font-size="4.5" font-weight="700" fill="#162013">1</text>
        </g>
        <g transform="rotate(4 23.75 16.75)">
          <rect x="16.5" y="9.5" width="14.5" height="14.5" rx="2.5" fill="currentColor"/>
          <text x="23.4" y="16.4" dominant-baseline="central" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="11" font-weight="700" fill="#162013">T</text>
          <text x="29.6" y="22.6" text-anchor="end" font-family="Georgia, 'Times New Roman', serif" font-size="4.5" font-weight="700" fill="#162013">1</text>
        </g>
      </svg>
    </a>
    <ul class="list">
      {sections.filter((s) => s.id !== 'home').map((link) => (
        <li><a href={`#${link.id}`} class="link" data-label={link.label}>{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Scroll-spy: bold the link whose section crosses a thin band across the
  // middle of the viewport (nothing is bold while the hero is in view).
  const nav = document.querySelector('nav[aria-label="Primary"]')
  const links = [...nav.querySelectorAll('.link')]
  const ids = ['home', ...links.map((l) => l.getAttribute('href').slice(1))]

  function setActive(id) {
    for (const link of links) {
      const active = link.getAttribute('href') === `#${id}`
      link.classList.toggle('active', active)
      if (active) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id)
    },
    { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
  )
  for (const id of ids) {
    const section = document.getElementById(id)
    if (section) observer.observe(section)
  }

  // the bar sits clear over the painting at the top, and picks up a blurred
  // backdrop once the page scrolls under it
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8)
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
  }

  .nav.scrolled {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    /* a soft shadow, not a rule: a hairline here stacked with the
       sections' own top rules into a double line */
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.7);
  }

  /* lined up with the content column below it */
  .bar {
    max-width: calc(var(--content-width) + 2 * var(--page-padding));
    margin: 0 auto;
    padding: 1rem var(--page-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: block;
    color: var(--color-accent);
    transition: color 0.2s ease;
  }

  .brand:hover,
  .brand:focus-visible {
    color: var(--color-text);
  }

  /* sized so the tiles optically match the links' cap height. the nudge up
     compensates for text's visual center sitting above its geometric center
     — a dead-centered mark reads as too low next to it */
  .brand svg {
    display: block;
    width: 3.25rem;
    height: auto;
    transform: translateY(-2px);
  }

  .list {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  /* light at rest so bold means "you are here" */
  /* padded to a 44px tap target; the hidden bold copy of the label reserves
     the bold width so the row doesn't shift when a link becomes current */
  .link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: var(--text-md);
    font-weight: 300;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .link:hover,
  .link:focus-visible {
    color: var(--color-accent);
  }

  .link::after {
    content: attr(data-label);
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 700;
  }

  .link.active {
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .bar {
      padding: 0.875rem var(--page-padding);
    }

    .list {
      gap: 1.5rem;
    }

    .link {
      font-weight: 400;
    }
  }
</style>
