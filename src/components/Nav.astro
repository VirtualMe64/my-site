---
// Top bar: rack logo + name on the left, section links on the right. The
// links derive from the same sections list that drives the section headers.
import { sections } from '../content/site.js'
---

<nav class="nav" aria-label="Primary">
  <div class="bar">
    <!-- the rack mark is inlined (not the favicon <img>): the favicon's square
         viewBox has dead space that renders it undersized -->
    <a class="brand" href="#home" aria-label="Sammy Taubman, home">
      <svg viewBox="0 7.5 32 17.5" aria-hidden="true">
        <g transform="rotate(-5 8.25 15.75)">
          <rect x="1" y="8.5" width="14.5" height="14.5" rx="2.5" fill="#d6b25e"/>
          <text x="7.9" y="15.4" dominant-baseline="central" text-anchor="middle" font-family="Georgia, serif" font-size="11" font-weight="700" fill="#111d16">S</text>
          <text x="14.1" y="21.6" text-anchor="end" font-family="Georgia, serif" font-size="4.5" font-weight="700" fill="#111d16">1</text>
        </g>
        <g transform="rotate(4 23.75 16.75)">
          <rect x="16.5" y="9.5" width="14.5" height="14.5" rx="2.5" fill="#d6b25e"/>
          <text x="23.4" y="16.4" dominant-baseline="central" text-anchor="middle" font-family="Georgia, serif" font-size="11" font-weight="700" fill="#111d16">T</text>
          <text x="29.6" y="22.6" text-anchor="end" font-family="Georgia, serif" font-size="4.5" font-weight="700" fill="#111d16">1</text>
        </g>
      </svg>
      <span class="name">Sammy Taubman</span>
    </a>

    <ul class="list">
      {sections.filter((s) => s.id !== 'home').map((link) => (
        <li><a href={`#${link.id}`} class="link">{link.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  // Scroll-spy: the section crossing the middle of the viewport marks its
  // link. Nothing is marked while the hero is in view.
  const links = [...document.querySelectorAll('nav[aria-label="Primary"] .link')]
  const ids = ['home', ...links.map((l) => l.getAttribute('href').slice(1))]

  function setActive(id) {
    for (const link of links) {
      const active = link.getAttribute('href') === `#${id}`
      link.classList.toggle('active', active)
      if (active) link.setAttribute('aria-current', 'true')
      else link.removeAttribute('aria-current')
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id)
    },
    { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
  )
  for (const id of ids) {
    const section = document.getElementById(id)
    if (section) observer.observe(section)
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    max-width: calc(var(--content-width) + 2 * var(--page-padding));
    margin: 0 auto;
    padding: 0.9rem var(--page-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* the nudge up: dead-centering an icon next to text reads as too low */
  .brand svg {
    width: 2.4rem;
    height: auto;
    transform: translateY(-1px);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1;
  }

  .list {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  /* links: muted at rest; the current section is ivory with a gold rule */
  .link {
    position: relative;
    display: inline-block;
    padding: 0.3rem 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1rem;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .link:hover,
  .link:focus-visible,
  .link.active {
    color: var(--color-text);
  }

  .link.active::after {
    transform: scaleX(1);
  }

  @media (max-width: 640px) {
    .name {
      display: none;
    }

    .list {
      gap: 1.25rem;
    }

    .link {
      font-size: 0.82rem;
    }
  }
</style>
