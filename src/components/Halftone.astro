---
// The poster's framed halftone close-up: whatever is in the slot (an <img>,
// an inline SVG) is screened into dots, live, in CSS.
//
// How: inside .screen the slotted image (greyscale) is multiplied by a grid
// of soft radial dots, then contrast(40) thresholds the result — dark areas
// of the image grow big dots, light areas shrink them to nothing. Drop a real
// photo in and it halftones the same way.
const { class: className } = Astro.props
---

<div class:list={['frame', className]} aria-hidden="true">
  <div class="screen">
    <div class="src"><slot /></div>
  </div>
</div>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    border: 1.25px solid var(--color-text);
    background: #fff;
    mix-blend-mode: multiply;    /* the white between dots becomes paper */
  }

  .screen {
    position: absolute;
    inset: 0;
    background: #fff;
    filter: contrast(40);
  }

  .src {
    position: absolute;
    inset: 0;
    filter: grayscale(1) blur(0.6px);
  }

  .src > :global(*) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(closest-side, #8f8f8f, #fff) 0 0 / 6px 6px;
    mix-blend-mode: multiply;
  }
</style>
