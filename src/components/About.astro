---
// The profile slide, straight from the poster's template: title up top, a
// column of three boxed facts (number → mascot pose → caption), a framed
// halftone close-up, and the signature at the bottom. The bio sits where the
// cutout photo stood.
import Slide from './Slide.astro'
import Mascot from './Mascot.astro'
import Halftone from './Halftone.astro'
import { getSection } from '../content/site.js'

const facts = [
  { pose: 'laptop', caption: 'Stripe', sub: 'agentic payments' },
  { pose: 'football', caption: 'Georgia Tech', sub: 'alum + football fan' },
  { pose: 'words', caption: 'Word games', sub: 'scrabble, mostly' },
]
---

<Slide {...getSection('about')} ghostAt="left" ghostTop="55%">
  <div class="layout">
    <ol class="facts">
      {facts.map((fact, i) => (
        <li>
          <span class="box">{i + 1}</span>
          <Mascot pose={fact.pose} class="pose" />
          <p class="caption">{fact.caption}</p>
          <p class="sub">{fact.sub}</p>
        </li>
      ))}
    </ol>

    <div class="profile">
      <!-- halftone "zoom" of the mascot: a filled, shaded version of its face
           (the screen turns the shading into dots). Swap in a photo here
           later and it gets the same treatment -->
      <Halftone class="zoom">
        <svg viewBox="22 14 76 92" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="fur" cx="0.45" cy="0.4" r="0.7">
              <stop offset="0" stop-color="#ececec" />
              <stop offset="1" stop-color="#8c8c8c" />
            </radialGradient>
          </defs>
          <rect x="0" y="0" width="130" height="130" fill="#f2f2f2" />
          <path d="M46 85C40 95 37 107 38 125H82C83 107 80 95 74 85Z" fill="#c8c8c8" />
          <path d="M31 64C27 48 29 32 35 21L46 35C53 32 67 32 74 35L85 21C91 32 93 48 89 64C87 79 75 87 60 87S33 79 31 64Z" fill="url(#fur)" stroke="#111" stroke-width="2.5" />
          <circle cx="48" cy="57" r="3.4" fill="#000" />
          <circle cx="72" cy="57" r="3.4" fill="#000" />
          <path d="M57 66q1.5 2.5 3 0q1.5 2.5 3 0" fill="none" stroke="#000" stroke-width="1.6" />
        </svg>
      </Halftone>

      <div class="bio">
        <p>Hi! I'm Sammy, a software engineer at <a href="https://stripe.com" target="_blank" rel="noreferrer">Stripe</a> working on agentic payments: the plumbing that lets AI agents pay for things.</p>
        <p>I've been programming for about ten years, and I'm happiest when I'm figuring out how something works. Before Stripe I spent three years as a teaching assistant at Georgia Tech, for everything from intro discrete math to graduate algorithms.</p>
        <p>Off the clock: Georgia Tech football, and word games — Scrabble most of all.</p>
      </div>
    </div>
  </div>

  <p class="signature" aria-hidden="true">sammy taubman</p>
</Slide>

<style>
  .layout {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 4rem;
    align-items: center;
  }

  .facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .facts li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .facts :global(.pose) {
    width: 7.5rem;
    margin: 0.5rem 0 0.25rem;
  }

  .sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .profile {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    gap: 3rem;
    align-items: center;
  }

  .profile :global(.zoom) {
    aspect-ratio: 3 / 4;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 30rem;
    font-size: 1.05rem;
  }

  .bio a {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .signature {
    margin-top: 4rem;
    transform: rotate(-3deg);
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    /* facts go across in a row, like three mini cards */
    .facts {
      flex-direction: row;
      justify-content: space-around;
      order: 2;
    }

    .profile {
      grid-template-columns: 14rem 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .layout {
      margin-top: 2.5rem;
    }

    .profile {
      grid-template-columns: 1fr;
    }

    .profile :global(.zoom) {
      width: 62%;
      justify-self: center;
    }

    .bio {
      font-size: var(--text-base);
    }

    .facts {
      gap: 0.5rem;
    }

    .facts :global(.pose) {
      width: 5.5rem;
    }

    .facts .caption {
      font-size: 0.7rem;
    }

    .sub {
      font-size: 0.7rem;
    }

    .signature {
      margin-top: 3rem;
    }
  }
</style>
