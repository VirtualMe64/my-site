---
// The closing slide ("see ya!"): a dot-matrix mascot in ghost dots, the
// links, the bracket caption, and the signature.
import Slide from './Slide.astro'
import DotMatrix from './DotMatrix.astro'
import { getSection, contact } from '../content/site.js'
---

<Slide {...getSection('contact')} ghostTop="2rem">
  <div class="dots"><DotMatrix /></div>

  <ul class="links">
    {contact.map((link) => (
      <li>
        <span class="caption">{link.label}</span>
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
          {link.display}
        </a>
      </li>
    ))}
  </ul>

  <p class="bracket bye" aria-hidden="true"><span>see ya !</span></p>
  <p class="signature" aria-hidden="true">sammy taubman</p>
</Slide>

<style>
  .dots {
    position: absolute;
    left: -2rem;
    top: 4rem;
    width: clamp(14rem, 32vw, 26rem);
    z-index: -1;
  }

  .links {
    list-style: none;
    margin: 4rem auto 0;
    max-width: 30rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .links li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .caption {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }

  .links a {
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  .bye {
    margin-top: 4rem;
  }

  .signature {
    margin-top: 2.5rem;
    transform: rotate(-3deg);
  }

  @media (max-width: 640px) {
    .dots {
      left: -1rem;
      top: 3rem;
      width: 13rem;
    }

    .links a {
      font-size: 1.05rem;
    }
  }
</style>
