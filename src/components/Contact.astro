---
import Section from './Section.astro'
import { getSection, contact } from '../content/site.js'
---

<Section {...getSection('contact')}>
  <ul class="links">
    {contact.map((link, i) => (
      <li class="row">
        <span class="label">{link.label}</span>
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
          {link.display}
        </a>
        {i === 0 && (
          <span class="note hi" aria-hidden="true">
            <svg class="scribble" viewBox="0 0 50 24" width="40"><path d="M46 14C34 20 18 18 6 10" /><path d="M5 18 5 9l9-1" /></svg>
            say hi!
          </span>
        )}
      </li>
    ))}
  </ul>

  <!-- sign-off, set in the serif italic like the margin notes -->
  <p class="signature" aria-hidden="true">sammy taubman</p>
</Section>

<style>
  .links {
    list-style: none;
    margin-top: 3rem;
    border-top: 1px solid var(--color-rule);
  }

  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .label {
    flex: 0 0 7rem;
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .row a {
    font-size: var(--text-md);
    font-weight: 300;
    overflow-wrap: anywhere;
  }

  .hi {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: 0.75rem;
    transform: rotate(-4deg) translateY(0.1rem);
  }


  .signature {
    margin-top: 3.5rem;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 1;
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .label {
      flex-basis: 5.5rem;
    }

    .hi {
      display: none;
    }
  }
</style>
