---
import Section from './Section.astro'
import { getSection, contact } from '../content/site.js'

const [email, ...others] = contact

// Instrument Serif's "1" is nearly an "l" — set digits in the sans so the
// address reads unambiguously
const emailParts = email.display.split(/(\d+)/).filter(Boolean)
---

<Section {...getSection('contact')} index={3}>
  <p class="label">Best by email</p>
  <a class="email" href={email.href}><span>{emailParts.map((part) => (/\d/.test(part) ? <span class="fig">{part}</span> : part))}</span><span class="arrow" aria-hidden="true">→</span></a>
  <ul class="others">
    {others.map((link) => (
      <li>
        <span class="label">{link.label}</span>
        <a class="underline" href={link.href} target="_blank" rel="noreferrer">{link.display}</a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .email:hover {
    color: var(--color-accent);
  }

  .fig {
    font-family: var(--font-sans);
    font-size: 0.86em;
    font-weight: 400;
  }

  .arrow {
    font-family: var(--font-sans);
    font-size: 0.55em;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .email:hover .arrow {
    transform: translateX(0.25em);
  }

  .others {
    list-style: none;
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
  }

  .others li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
</style>
