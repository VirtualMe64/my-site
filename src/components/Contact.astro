---
import Section from './Section.astro'
import { getSection, contact } from '../content/site.js'
---

<Section {...getSection('contact')}>
  <!-- three forms of the same entry, set across the column: label above,
       address below -->
  <ul class="links">
    {contact.map((link) => (
      <li class="row">
        <span class="label">{link.label}</span>
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
          {link.display}
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .links {
    list-style: none;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.25rem 1.4rem 0;
  }

  .row + .row {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-rule);
  }

  .label {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .row a {
    font-size: var(--text-base);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--color-text-muted);
    text-underline-offset: 4px;
  }

  @media (max-width: 640px) {
    .links {
      grid-template-columns: 1fr;
    }

    .row,
    .row + .row {
      padding: 1rem 0;
      border-left: none;
    }

    .row + .row {
      border-top: 1px solid var(--color-rule);
    }
  }
</style>
