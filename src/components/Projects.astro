---
import Section from './Section.astro'
import { getSection } from '../content/site.js'
import { projects } from '../content/projects.js'
import { md } from '../lib/md.js'
---

<Section {...getSection('projects')} index={2}>
  <!-- typeset entries, two to a row, each under its own hairline -->
  <ul class="grid">
    {projects.map((project) => (
      <li class="project">
        <h3 class="name">{project.name} <span class="pos">{project.pos}</span></h3>
        <p class="def prose" set:html={md(project.def)} />
        <div class="meta">
          <p class="label">{project.stack}</p>
          <p class="links">
            {project.links.map((link) => (
              <a class="underline" href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 0 2.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    text-wrap: balance;
  }

  .name .pos {
    font-size: 0.7em;
  }

  .def {
    margin-top: 0.75rem;
    flex: 1;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .def :global(a) {
    color: var(--color-text);
  }

  /* stack on one line, links on the next — the same shape on every entry */
  .meta {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--text-sm);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .name {
      font-size: 1.55rem;
    }
  }
</style>
