---
import Section from './Section.astro'
import { getSection } from '../content/site.js'
import { projects } from '../content/projects.js'
import { md } from '../lib/md.js'
---

<Section {...getSection('projects')}>
  <div class="grid">
    {projects.map((project, i) => (
      <article class="card">
        <header class="cardHead">
          <span class="box">{i + 1}</span>
          <p class="name">{project.name} <span class="pos">{project.pos}</span></p>
          {i === 0 && (
            <span class="note newest" aria-hidden="true">
              newest!
              <svg class="scribble" viewBox="0 0 40 34" width="30"><path d="M36 4C22 6 10 14 6 28" /><path d="M2 20l4 9 8-5" /></svg>
            </span>
          )}
        </header>
        <p class="def" set:html={md(project.def)} />
        <footer class="cardFoot">
          <span class="stack">{project.stack}</span>
          <span class="links">
            {project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </span>
        </footer>
      </article>
    ))}
  </div>
</Section>

<style>
  .grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--color-rule);
  }

  .card {
    position: relative;
    padding: 1.75rem 2rem 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-bottom: 1px solid var(--color-rule);
  }

  /* right column: a center rule and mirrored padding */
  .card:nth-child(even) {
    padding: 1.75rem 0 1.75rem 2rem;
    border-left: 1px solid var(--color-rule);
  }

  /* hovering a card highlights its entry, like running a finger down the page */
  @media (hover: hover) {
    .card {
      transition: background-color 0.2s ease;
    }

    .name {
      transition: color 0.2s ease;
    }

    .card:hover {
      background-color: var(--color-wash);
    }

    .card:hover .name {
      color: var(--color-accent);
    }
  }

  .cardHead {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.15;
    text-wrap: balance;
  }

  .pos {
    font-size: var(--text-sm);
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-muted);
  }

  .newest {
    right: 0;
    top: -2.2rem;
    display: flex;
    align-items: flex-end;
    gap: 0.2rem;
    transform: rotate(3deg);
  }

  .newest svg {
    transform: scaleX(-1);
  }

  .def {
    font-weight: 300;
    font-size: var(--text-base);
    line-height: 1.55;
    flex: 1;
  }

  /* definition links are underlined at rest; hover styling is global.
     :global because the markup comes from set:html */
  .def :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .cardFoot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 0.25rem;
  }

  .stack {
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  /* links: ivory with a quiet underline, each marked ↗ */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .links a {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .links a::after { content: ' ↗'; }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card,
    .card:nth-child(even) {
      padding: 1.5rem 0;
      border-left: none;
    }

    .newest {
      top: -1.9rem;
    }
  }
</style>
