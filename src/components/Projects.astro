---
// Projects, each laid out like one of the profile slide's facts turned
// sideways: boxed number over a red doodle on the left, the write-up on the
// right, links as red [ bracket ] tags.
import Slide from './Slide.astro'
import Doodle from './Doodle.astro'
import { getSection } from '../content/site.js'
import { projects } from '../content/projects.js'
import { md } from '../lib/md.js'
---

<Slide {...getSection('projects')} ghostAt="left" ghostTop="1.5rem">
  <ol class="grid">
    {projects.map((project, i) => (
      <li class="card">
        <div class="mark">
          <span class="box">{i + 1}</span>
          <Doodle name={project.doodle} />
        </div>
        <div class="body">
          <h3 class="name">{project.name}</h3>
          <p class="def" set:html={md(project.def)} />
          <p class="stack">{project.stack}</p>
          <p class="links">
            {project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </p>
        </div>
      </li>
    ))}
  </ol>
</Slide>

<style>
  .grid {
    list-style: none;
    margin-top: 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem 4rem;
  }

  .card {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .name {
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .card:hover .name {
      color: var(--color-accent);
    }
  }

  .def {
    margin-top: 0.5rem;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .def :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .def :global(a:hover) {
    color: var(--color-accent);
  }

  .stack {
    margin-top: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .links {
    margin-top: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .links a {
    color: var(--color-accent);
  }

  .links a::before { content: '['; margin-right: 0.5em; }
  .links a::after { content: ']'; margin-left: 0.5em; }

  .links a:hover {
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .grid {
      margin-top: 3rem;
      gap: 2.5rem;
    }

    .card {
      grid-template-columns: 3.25rem 1fr;
      gap: 1rem;
    }

    .card :global(.doodle) {
      width: 3.25rem;
    }
  }
</style>
