---
// A dot-matrix drawing, like the pixel-dot art on the poster's closing
// slide. The art is plain text below ('#' = a dot) so it's easy to redraw;
// it becomes one SVG circle per '#' at build time.
const { class: className } = Astro.props

const art = `
....##..............##....
...#..#............#..#...
...#...#..........#...#...
..#.....##########.....#..
..#....................#..
.#......................#.
.#......##......##......#.
.#......##......##......#.
.#......................#.
#.........#.##.#.........#
.#.........#..#.........#.
..#....................#..
...##................##...
.....##............##.....
.......############.......
......#............#......
.....#..............#.....
`
const rows = art.trim().split('\n')
const dots = rows.flatMap((row, y) => [...row].flatMap((c, x) => (c === '#' ? [[x, y]] : [])))
---

<svg class:list={['matrix', className]} viewBox={`-0.5 -0.5 ${rows[0].length} ${rows.length}`} aria-hidden="true">
  {dots.map(([x, y]) => <circle cx={x} cy={y} r="0.32" />)}
</svg>

<style>
  .matrix {
    display: block;
    height: auto;
    fill: var(--color-ghost);
  }
</style>
