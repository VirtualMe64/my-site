---
import { scrabbleScore } from '../content/scrabble.js'

// the entry's "pronunciation" line, in the site's other language: the first
// name played as Scrabble tiles, real letter scores, with the play's total
const rack = [...'SAMMY']
const total = scrabbleScore('SAMMY')
---

<!-- The hero is the site's one hand-rolled dictionary entry: its text lives
     here rather than in src/content/ so it can be literal, readable markup. -->
<section id="home">
  <div class="entry">
    <!-- the interpunct spans must stay aria-hidden so screen readers hear
         "Sammy Taubman", not the syllable breaks -->
    <h1 class="headword">
      Sam<span aria-hidden="true">·</span>my Taub<span aria-hidden="true">·</span>man
      <span class="pos">n. proper</span>
    </h1>

    <p class="play" role="img" aria-label={`Scrabble tiles: SAMMY, ${total} points`}>
      <span class="rack" aria-hidden="true">
        {rack.map((letter) => <span class="tile">{letter}<sub>{scrabbleScore(letter)}</sub></span>)}
      </span>
      <span class="pts" aria-hidden="true">{total} pts</span>
    </p>

    <ol class="definitions" role="list">
      <li><span class="num">1.</span> a software engineer at Stripe, helping agents pay for things</li>
      <li><span class="num">2.</span> a former Georgia Tech student and current Georgia Tech football fan</li>
      <li><span class="num">3.</span> a lover of word games, especially Scrabble</li>
    </ol>

    <p class="seeAlso">
      See also: <a href="#experience">experience</a>, <a href="#projects">projects</a>
    </p>
  </div>
</section>

<style>
  /* a soft dark scrim behind the text column (see ::before) so the hill
     line never competes with the senses */
  .entry {
    position: relative;
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    --headword-size: var(--headword-size-hero);
    --pos-size: 0.45em;   /* the hero headword is big enough already */
    /* a lighter sage for the hero's muted text ("n. proper", "See also"):
       the site's muted color is fine on the plain green, but over the
       painting's misty hills it dropped to ~2.7:1 */
    --color-text-muted: #b4c8b4;
  }

  .entry::before {
    content: '';
    position: absolute;
    inset: -5rem 20% -4rem -8rem;
    z-index: -1;
    pointer-events: none;
    /* reaches zero exactly at the box edges, so it has no visible border */
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(12, 22, 13, 0.55), rgba(12, 22, 13, 0.3) 55%, transparent 100%);
  }

  @media (max-width: 640px) {
    .entry::before {
      inset: -3rem -1.5rem;
      background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(12, 22, 13, 0.5), rgba(12, 22, 13, 0.25) 55%, transparent 100%);
    }
  }

  /* desktop: each sense on its own line, numbers hanging in the margin */
  .definitions {
    list-style: none;
    max-width: 40rem;
    margin-top: 1.25rem;
    text-wrap: pretty;     /* no stranded one-word last lines */
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* the number gets its own column so each sense's text, wrapped lines
     included, starts at one x — a text-indent hang can't, since the digits
     are proportional ("1." is narrower than "4.") */
  .definitions li {
    display: grid;
    grid-template-columns: 1.5em 1fr;
  }

  /* mobile keeps the senses run together in one block, as before */
  @media (max-width: 640px) {
    .definitions {
      display: block;
      margin-top: 1rem;
    }

    .definitions li {
      display: inline;       /* also undoes the desktop grid */
    }

    .definitions li + li::before {
      content: ' ';
      white-space: pre;
    }
  }

  .num {
    font-weight: 700;
    color: var(--color-accent);
  }

  /* the tile rack: gold tiles like the logo's, tilted a hair so they read
     hand-placed, scores in the corners */
  .play {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.9rem;
  }

  .rack {
    display: flex;
    gap: 0.3rem;
  }

  .tile {
    position: relative;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 0.28rem;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }

  .tile:nth-child(odd) { transform: rotate(-2.5deg); }
  .tile:nth-child(3n) { transform: rotate(2deg); }

  .tile sub {
    position: absolute;
    right: 0.14rem;
    bottom: 0.06rem;
    font-size: 0.55rem;
  }

  .pts {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .tile {
      width: 1.7rem;
      height: 1.7rem;
      font-size: 0.95rem;
    }
  }

  /* cross-reference — same size as the senses above, muted italic so it
     still reads as an aside */
  .seeAlso {
    margin-top: 1.5rem;
    font-style: italic;
    color: var(--color-text-muted);
  }

  /* underlined at rest so it reads as a link; hover bolds instead */
  .seeAlso a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .seeAlso a:hover {
    color: var(--color-accent);
  }
</style>
