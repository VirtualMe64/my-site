---
// The hero: the site's one hand-rolled dictionary entry on the left; on the
// right, Sammy rising out of a corner of a Scrabble board with SAMMY played
// in an arc around him. The entry's text lives here (not src/content/) so it
// stays literal, readable markup.
import { stats } from '../content/site.js'
import { scrabbleScore } from '../content/scrabble.js'

// the board window is the 5×5 around the center star of a real 15×15 board,
// so the premium squares sit where they actually do: rows/cols 6–10
const board = [
  ['tl', '', '', '', 'tl'],
  ['', 'dl', '', 'dl', ''],
  ['', '', 'star', '', ''],
  ['', 'dl', '', 'dl', ''],
  ['tl', '', '', '', 'tl'],
]

// SAMMY in an arc around the board's lower-left corner (offsets in em)
const arc = [
  { letter: 'S', x: -3.4, y: 8.6, r: -10 },
  { letter: 'A', x: -2.6, y: 13.4, r: 5 },
  { letter: 'M', x: 0.2, y: 17.4, r: -4 },
  { letter: 'M', x: 4.6, y: 19.8, r: 8 },
  { letter: 'Y', x: 9.2, y: 20.6, r: -9 },
]
const total = scrabbleScore('SAMMY')
// tiles are set at 1.55× the art's font-size, so their own em is bigger;
// divide to keep the offsets above in art ems
const TILE_SCALE = 1.55
---

<section id="home" class="hero">
  <div class="inner">
    <div class="entry">
      <p class="mono">entry no. 001 &nbsp;·&nbsp; <em>n. proper</em></p>
      <!-- the interpunct spans stay aria-hidden so screen readers hear
           "Sammy Taubman", not the syllable breaks -->
      <h1 class="headword name">
        Sam<span class="dot" aria-hidden="true">·</span>my<br />Taub<span class="dot" aria-hidden="true">·</span>man
      </h1>

      <ol class="senses">
        <li><span class="chip tw">1</span><span>a software engineer at <a href="https://stripe.com" target="_blank" rel="noreferrer">Stripe</a>, helping agents pay for things</span></li>
        <li><span class="chip dw">2</span><span>a programmer with 10 years of experience who is passionate about learning how things work</span></li>
        <li><span class="chip dl">3</span><span>a former Georgia Tech student and current Georgia Tech football fan</span></li>
        <li><span class="chip tl">4</span><span>a lover of word games, especially Scrabble</span></li>
      </ol>

      <div class="actions">
        <a class="btn primary" href="#projects">See my work</a>
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="art" aria-hidden="true">
      <div class="board">
        {board.flat().map((cell) => (
          <span class:list={['sq', cell]}>
            {cell === 'star' ? '★' : cell ? cell.toUpperCase() : ''}
          </span>
        ))}
        <img class="photo" src="/me-cutout.webp" alt="" width="698" height="900" />
      </div>
      {arc.map((t) => (
        <span class="tile arc" style={`left:${(t.x / TILE_SCALE).toFixed(3)}em; top:${(t.y / TILE_SCALE).toFixed(3)}em; transform:rotate(${t.r}deg)`}>
          {t.letter}<sub>{scrabbleScore(t.letter)}</sub>
        </span>
      ))}
      <p class="mono score">S·A·M·M·Y &nbsp;=&nbsp; <em>{total} pts</em></p>
    </div>
  </div>

  <!-- the stat strip: a recessed rack of quick facts under the fold line -->
  <ul class="stats">
    {stats.map((s) => (
      <li><span class="value">{s.value}</span><span class="label">{s.label}</span></li>
    ))}
  </ul>
</section>

<style>
  .hero {
    min-height: calc(100dvh - 3.9rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .inner {
    flex: 1;
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 4.5rem var(--page-padding) 5rem;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .name {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 6.4vw, 5.6rem);
    line-height: 0.95;
  }

  .senses {
    list-style: none;
    margin-top: 2rem;
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: var(--text-md);
    text-wrap: pretty;
  }

  .senses li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .senses a {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  /* sense numbers on premium-square colors */
  .chip {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.15rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-tile-ink);
  }

  .chip.tw { background: var(--color-tw); }
  .chip.dw { background: var(--color-dw); }
  .chip.dl { background: var(--color-dl); }
  .chip.tl { background: var(--color-tl); color: #fff; }

  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ---- the art: em-based so one font-size scales it all ---- */
  .art {
    position: relative;
    justify-self: center;
    width: 24em;
    height: 26em;
    font-size: 1rem;
  }

  /* the board corner; the photo rises out of it (clip-path lets the head
     and arms past the top and sides, the bottom edge crops the legs) */
  .board {
    position: absolute;
    left: 0;
    bottom: 2em;
    width: 24em;
    height: 24em;
    padding: 0.5em;
    border-radius: 0.8em;
    background: #0b2219;
    box-shadow: 0 1.2em 2.4em -1em rgba(0, 0, 0, 0.6);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.35em;
    clip-path: inset(-40% -30% 0 -30% round 0.8em);
  }

  .sq {
    display: grid;
    place-items: center;
    border-radius: 0.3em;
    background: #1c4a37;
    font-family: var(--font-mono);
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(29, 26, 20, 0.7);
  }

  .sq.tl { background: var(--color-tl); color: rgba(255, 255, 255, 0.75); }
  .sq.dl { background: var(--color-dl); }
  .sq.star { background: var(--color-dw); font-size: 1.4em; }

  .photo {
    position: absolute;
    left: 50%;
    bottom: -1em;
    width: auto;
    height: 29em;
    transform: translateX(-50%);
    filter: drop-shadow(0 0.8em 1.2em rgba(0, 0, 0, 0.45));
  }

  .arc {
    position: absolute;
    font-size: 1.55em;
  }

  .score {
    position: absolute;
    right: 0;
    bottom: 0;
  }

  /* ---- stat strip ---- */
  .stats {
    list-style: none;
    background: var(--color-bg-deep);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stats li {
    padding: 1.6rem var(--page-padding);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.75rem;
  }

  .stats li + li {
    border-left: 1px solid var(--color-rule);
  }

  .value {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-dw);
  }

  .label {
    max-width: 9rem;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats li:nth-child(3) {
      border-left: none;
    }

    .stats li:nth-child(n + 3) {
      border-top: 1px solid var(--color-rule);
    }
  }

  @media (max-width: 640px) {
    .inner {
      padding: 3rem var(--page-padding) 3.5rem;
      gap: 3rem;
    }

    .art {
      font-size: 0.72rem;
      margin-left: 2.5em;   /* room for the arc on the left */
    }

    .senses {
      font-size: var(--text-base);
    }

    .stats li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding: 1.25rem var(--page-padding);
    }

    .value {
      font-size: 1.9rem;
    }
  }
</style>
