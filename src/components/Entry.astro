<!-- The hero: the site's one hand-rolled dictionary entry, set large, with a
     portrait standing on the section's bottom rule. The text lives here (not
     src/content/) so it stays literal, readable markup. -->
<section id="home" class="hero">
  <div class="inner">
    <div class="entry">
      <p class="kicker"><span class="label">Entry</span> <span class="pos">n. proper</span></p>
      <!-- the interpunct spans stay aria-hidden so screen readers hear
           "Sammy Taubman", not the syllable breaks -->
      <h1 class="headword name">
        Sam<span class="dot" aria-hidden="true">·</span>my<br />Taub<span class="dot" aria-hidden="true">·</span>man
      </h1>

      <ol class="senses prose">
        <li><span class="num">1</span><span>A software engineer at <a href="https://stripe.com" target="_blank" rel="noreferrer">Stripe</a>, helping agents pay for things.</span></li>
        <li><span class="num">2</span><span>A programmer with ten years of experience, passionate about learning how things work.</span></li>
        <li><span class="num">3</span><span>A former Georgia Tech student and current Georgia Tech football fan.</span></li>
        <li><span class="num">4</span><span>A lover of word games, especially Scrabble.</span></li>
      </ol>

      <p class="seeAlso">
        <span class="pos">See also</span>
        <a class="underline" href="#experience">experience</a>,
        <a class="underline" href="#projects">projects</a>
      </p>
    </div>

    <figure class="portrait" aria-hidden="true">
      <img src="/me.webp" alt="" width="999" height="1100" />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 0 var(--page-padding);
    overflow: hidden;
  }

  .inner {
    position: relative;
    max-width: var(--content-width);
    min-height: calc(100dvh - 4.3rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: center;
  }

  .entry {
    position: relative;
    z-index: 1;               /* above the portrait where they meet */
    padding: 6rem 0;
  }

  .kicker {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .kicker .pos {
    font-size: 1.1rem;
  }

  .name {
    margin-top: 1.25rem;
    font-size: clamp(4.25rem, 10vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .senses {
    list-style: none;
    margin-top: 2.75rem;
    max-width: 30rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--text-md);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* each sense's text starts at one x: the numeral gets its own column */
  .senses li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    align-items: baseline;
  }

  .num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.35em;
    line-height: 1;
    color: var(--color-accent);
  }

  .seeAlso {
    margin-top: 2.25rem;
    color: var(--color-text-muted);
  }

  .seeAlso .pos {
    margin-right: 0.4rem;
    font-size: 1.15em;
  }

  /* the portrait stands on the section's bottom rule; its legs are already
     faded out in the image itself */
  .portrait {
    align-self: end;
    justify-self: end;
    width: 100%;
    max-width: 38rem;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    object-position: bottom right;
  }

  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .entry {
      padding: 4rem 0 0;
    }

    .portrait {
      justify-self: center;
      max-width: 30rem;
      margin-top: 1rem;
    }
  }

  @media (max-width: 640px) {
    .entry {
      padding-top: 3rem;
    }

    .senses {
      margin-top: 2rem;
    }

    .portrait {
      max-width: 100%;
    }
  }
</style>
