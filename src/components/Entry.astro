<!-- The hero is the site's one hand-rolled dictionary entry: its text lives
     here rather than in src/content/ so it can be literal, readable markup.

     Layout: ghost syllables "sam / my" behind, the headword set large, a
     portrait popping out of an engraved frame with SAMMY played in an arc
     around it, and the senses as numbered cards with fine-line drawings.
     Everything gold-and-drawn is decorative and aria-hidden. -->
<section id="home">
  <p class="ghost" aria-hidden="true"><span>sam</span><span>my</span></p>

  <div class="entry">
    <div class="top">
      <div class="head">
        <span class="note me" aria-hidden="true">
          that's me!
          <svg class="scribble" viewBox="0 0 60 40" width="46"><path d="M4 4c14 2 26 12 30 30" /><path d="M27 27l7 8 4-10" /></svg>
        </span>
        <!-- the interpunct spans must stay aria-hidden so screen readers hear
             "Sammy Taubman", not the syllable breaks -->
        <h1 class="headword">
          Sam<span aria-hidden="true">·</span>my<br />Taub<span aria-hidden="true">·</span>man
          <span class="pos">n. proper<svg class="scribble circle" viewBox="0 0 120 50" preserveAspectRatio="none" aria-hidden="true"><ellipse cx="60" cy="25" rx="57" ry="22" vector-effect="non-scaling-stroke" /></svg></span>
        </h1>
        <p class="bracket kicker">software engineer &nbsp;·&nbsp; stripe</p>
      </div>

      <!-- the portrait: a color cutout of Sammy popping out of an
           engraved frame (head and hands break the frame), with SAMMY
           played as tiles in an arc around it, real letter scores -->
      <div class="rack" aria-hidden="true">
        <div class="inset"><img class="photo" src="/me-cutout.webp" alt="" width="698" height="900" /></div>
        <span class="tile" style="--x:3em; --y:5.4em; --r:-8deg">S<sub>1</sub></span>
        <span class="tile" style="--x:4.4em; --y:10em; --r:6deg">A<sub>1</sub></span>
        <span class="tile" style="--x:7em; --y:13.6em; --r:-4deg">M<sub>3</sub></span>
        <span class="tile" style="--x:11.4em; --y:14.8em; --r:9deg">M<sub>3</sub></span>
        <span class="tile" style="--x:15.8em; --y:14.4em; --r:-11deg">Y<sub>4</sub></span>
        <span class="note pts">
          <svg class="scribble" viewBox="0 0 70 30" width="54"><path d="M66 22C48 26 22 22 6 8" /><path d="M5 18L5 7l11 1" /></svg>
          12 pts!
        </span>
      </div>
    </div>

    <ol class="senses">
      <li>
        <span class="box">1</span>
        <svg class="scribble doodle" viewBox="0 0 64 56" aria-hidden="true"><rect x="8" y="14" width="44" height="28" rx="4" /><path d="M8 22h44M30 35h14" /><rect x="13" y="28" width="9" height="7" rx="1.5" /><path d="M56 4v9M51.5 8.5h9" /></svg>
        <p>a software engineer at Stripe, helping agents pay for things</p>
      </li>
      <li>
        <span class="box">2</span>
        <svg class="scribble doodle" viewBox="0 0 64 56" aria-hidden="true"><path d="M20 16 8 28l12 12M44 16l12 12-12 12M36 10l-8 36" /></svg>
        <p>a programmer with 10 years of experience who is passionate about learning how things work</p>
      </li>
      <li>
        <span class="box">3</span>
        <svg class="scribble doodle" viewBox="0 0 64 56" aria-hidden="true"><ellipse cx="32" cy="28" rx="22" ry="13" transform="rotate(-25 32 28)" /><path d="M22.9 32.2 41.1 23.8M25.3 27.8l2.6 5.4M28.9 26.1l2.6 5.4M32.5 24.5l2.6 5.4M36.1 22.8l2.6 5.4" /></svg>
        <p>a former Georgia Tech student and current Georgia Tech football fan</p>
      </li>
      <li>
        <span class="box">4</span>
        <svg class="scribble doodle" viewBox="0 0 64 56" aria-hidden="true"><rect x="12" y="10" width="36" height="36" rx="4" /><text class="ink" x="29" y="37" text-anchor="middle" font-size="26">Q</text><text class="ink" x="45" y="43" text-anchor="end" font-size="9">10</text><path d="M56 9c-1.5-3-6-2-4.5 1.5L56 15l4.5-4.5C62 7 57.5 6 56 9z" /></svg>
        <p>a lover of word games, especially Scrabble</p>
      </li>
    </ol>

    <p class="bracket seeAlso">see also <a href="#experience">experience</a></p>
  </div>
</section>

<style>
  #home {
    min-height: calc(100dvh - 3.6rem);   /* full screen under the top bar */
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 6rem;
    padding-bottom: 5rem;
  }

  .ghost {
    position: absolute;
    top: 1rem;
    right: -0.04em;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(8rem, 24vw, 22rem);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.03em;
    color: var(--color-ghost);
    pointer-events: none;
    user-select: none;
  }

  .entry {
    position: relative;
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    --headword-size: var(--headword-size-hero);
    --pos-size: 0.36em;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .head {
    position: relative;
  }

  .headword .pos {
    position: relative;
    white-space: nowrap;
  }

  /* a fine gold ring around "n. proper" */
  .circle {
    position: absolute;
    left: -0.5em;
    top: -0.2em;
    width: calc(100% + 1em);
    height: calc(100% + 0.5em);
    stroke-width: 1;
  }

  .kicker {
    margin-top: 1.25rem;
    text-transform: lowercase;
  }

  .me {
    top: -2.6rem;
    left: -0.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    transform: rotate(-4deg);
  }

  .me svg {
    margin-top: 0.6rem;
  }

  /* ---- the tile cutout. em-based so one font-size scales the whole
     arrangement (it shrinks on mobile) ---- */
  .rack {
    position: relative;
    flex: none;
    width: 22em;
    height: 19em;
    font-size: 1rem;
  }

  /* each tile is set at 2.3× the rack's em so its letter fills it; the
     --x/--y offsets are given in rack ems, hence the division */
  .tile {
    position: absolute;
    left: calc(var(--x) / 2.3);
    top: calc(var(--y) / 2.3);
    width: 1.83em;
    height: 1.83em;
    display: grid;
    place-items: center;
    border-radius: 0.2em;
    background: linear-gradient(160deg, #f4ecd8, var(--color-tile) 60%, #d9cba8);
    box-shadow:
      0 2px 0 #b9aa86,
      0 12px 20px -8px rgba(0, 0, 0, 0.6);
    transform: rotate(var(--r));
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 2.3em;
    font-weight: 700;
    line-height: 1;
    color: var(--color-tile-ink);
  }

  .tile sub {
    position: absolute;
    right: 0.16em;
    bottom: 0.14em;
    font-size: 0.36em;
  }

  /* the frame: a fine gold rule around an engraved panel (diagonal hatch,
     like a plate in an old dictionary). clip-path lets the head and hands
     break out past the top and sides while the bottom edge crops the legs */
  .inset {
    position: absolute;
    right: 0;
    top: 1.5em;
    width: 10em;
    height: 13em;
    border: 1px solid var(--color-accent);
    background: repeating-linear-gradient(135deg, rgba(214, 178, 94, 0.22) 0 1px, transparent 1px 7px);
    clip-path: inset(-5em -4em 0 -4em);
  }

  .photo {
    position: absolute;
    left: -2.6em;
    top: -2.4em;
    width: 15.2em;
    height: auto;
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.55));
  }

  .pts {
    right: -1.25rem;
    bottom: -2rem;
    display: flex;
    align-items: flex-end;
    gap: 0.2rem;
    transform: rotate(-3deg);
  }


  /* ---- senses: four profile-card columns ---- */
  .senses {
    list-style: none;
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .senses li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
  }

  .senses p {
    font-size: var(--text-base);
    line-height: 1.5;
    text-wrap: pretty;     /* no stranded one-word last lines */
  }

  .doodle {
    width: 4.5rem;
    height: auto;
  }

  .doodle .ink {
    fill: var(--color-accent);
    stroke: none;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .seeAlso {
    margin-top: 3.5rem;
    justify-content: center;
  }

  .seeAlso a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  /* tablet: rack drops under the headword, senses go 2×2 */
  @media (max-width: 960px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .rack {
      align-self: center;
    }

    .senses {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* phone: senses become rows — number + doodle on the left, text right */
  @media (max-width: 640px) {
    #home {
      padding-top: 5.5rem;
      padding-bottom: 4rem;
    }

    .ghost {
      font-size: 8.5rem;
      top: 0.5rem;
    }

    .rack {
      font-size: 0.72rem;
    }

    .me {
      top: -2.3rem;
    }

    .senses {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 2.75rem;
    }

    .senses li {
      display: grid;
      grid-template-columns: auto 3.25rem 1fr;
      align-items: center;
      gap: 0.75rem;
      text-align: left;
    }

    .doodle {
      width: 3.25rem;
    }

    .seeAlso {
      margin-top: 2.75rem;
    }
  }
</style>
