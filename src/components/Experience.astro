---
import Section from './Section.astro'
import { getSection } from '../content/site.js'
import { roles } from '../content/roles.js'
import { md } from '../lib/md.js'
---

<Section {...getSection('experience')} index={1}>
  <ol class="roles">
    {roles.map((role, i) => (
      <li>
        <div class="who">
          <h3 class="company"><a href={role.url} target="_blank" rel="noreferrer">{role.company}</a></h3>
          <p class="title">{role.title}</p>
          <p class="label dates">
            {i === 0 && <span class="current">Current &nbsp;·&nbsp; </span>}{role.dates}
          </p>
        </div>
        <p class="desc prose" set:html={md(role.description)} />
      </li>
    ))}
  </ol>
</Section>

<style>
  .roles {
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .roles li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 0.75rem 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .company {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.05;
  }

  .company a {
    transition: color 0.2s ease;
  }

  .company a:hover {
    color: var(--color-accent);
  }

  .title {
    margin-top: 0.35rem;
  }

  .dates {
    margin-top: 0.6rem;
  }

  .current {
    color: var(--color-accent);
  }

  .desc {
    padding-top: 0.35rem;
    color: var(--color-text-muted);
  }

  .desc :global(a) {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .roles li {
      grid-template-columns: 1fr;
      padding: 1.75rem 0;
    }

    .company {
      font-size: 1.7rem;
    }

    .desc {
      padding-top: 0;
    }
  }
</style>
