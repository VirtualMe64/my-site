---
import Section from './Section.astro'
import { getSection } from '../content/site.js'
import { roles } from '../content/roles.js'
import { md } from '../lib/md.js'
---

<Section {...getSection('experience')} index={1}>
  <!-- a timeline: dates in a mono column, a rail of dots, then the role -->
  <ol class="timeline">
    {roles.map((role, i) => (
      <li>
        <p class="mono when">{role.dates}</p>
        <span class:list={['pip', { now: i === 0 }]} aria-hidden="true" />
        <div class="what">
          <p class="company">
            <a href={role.url} target="_blank" rel="noreferrer">{role.company}</a>
            {i === 0 && <span class="badge">now</span>}
          </p>
          <p class="title">{role.title}</p>
          <p class="desc" set:html={md(role.description)} />
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .timeline {
    list-style: none;
    position: relative;
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1.5rem 1fr;
    gap: 0 1.25rem;
    padding-bottom: 2.5rem;
  }

  /* the rail: one line down the pip column, stopping at the last pip */
  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(11rem + 1.25rem + 0.75rem - 0.5px);
    top: 0.9rem;
    bottom: -0.4rem;
    width: 1px;
    background: var(--color-rule);
  }

  .when {
    padding-top: 0.35rem;
    text-align: right;
  }

  .pip {
    justify-self: center;
    margin-top: 0.45rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 3px;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1.5px var(--color-text-muted);
  }

  .pip.now {
    background: var(--color-tw);
    box-shadow: 0 0 0 4px rgba(224, 96, 79, 0.25);
  }

  .company {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
  }

  .badge {
    padding: 0.1rem 0.45rem;
    border-radius: 4px;
    background: var(--color-tw);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    color: var(--color-dl);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .desc {
    margin-top: 0.4rem;
    max-width: 38rem;
    color: var(--color-text-muted);
  }

  /* links in descriptions (markup from set:html, hence :global) */
  .desc :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .desc :global(a:hover) {
    color: var(--color-tw);
  }

  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 1.5rem 1fr;
      gap: 0 0.9rem;
      padding-bottom: 2rem;
    }

    .timeline li:not(:last-child)::before {
      left: calc(0.75rem - 0.5px);
    }

    .when {
      grid-column: 2;
      grid-row: 2;
      text-align: left;
      padding-top: 0;
      order: 3;
    }

    .pip { grid-column: 1; grid-row: 1; }
    .what { grid-column: 2; grid-row: 1; }
    .desc { margin-top: 0.3rem; }
  }
</style>
