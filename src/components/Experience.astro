---
// The overview slide ("EXECUTIVE BOARD"): everyone in a grid, each labeled in
// red marker, and every label drawn on a little differently — circled, with
// an arrow, a measuring bar, or a swoosh underneath (role.mark).
import Slide from './Slide.astro'
import { getSection } from '../content/site.js'
import { roles } from '../content/roles.js'
import { md } from '../lib/md.js'
---

<Slide {...getSection('experience')} ghostTop="2rem">
  <ol class="grid">
    {roles.map((role) => (
      <li class:list={['role', `mark-${role.mark}`]}>
        {role.mark === 'bar' && <span class="bar" aria-hidden="true" />}
        <p class="label" aria-hidden="true">
          <span class="hand">{role.label}</span>
          {role.mark === 'circle' && <svg class="ink ring" viewBox="0 0 120 50" preserveAspectRatio="none"><path d="M72 7C40 2 6 10 5 26s34 21 62 19 49-9 47-23S84 3 50 8" /></svg>}
          {role.mark === 'swoosh' && <svg class="ink swoosh" viewBox="0 0 120 14" preserveAspectRatio="none"><path d="M3 9C30 4 70 3 117 6M20 12c25-3 50-4 80-3" /></svg>}
          {role.mark === 'arrow' && <svg class="ink arrow" viewBox="0 0 40 34" width="26"><path d="M34 3C20 6 10 14 8 28" /><path d="M2 21l6 8 7-6" /></svg>}
        </p>
        <p class="company"><a href={role.url} target="_blank" rel="noreferrer">{role.company}</a></p>
        <p class="meta">{role.title}</p>
        <p class="dates">{role.dates}</p>
        <p class="desc" set:html={md(role.description)} />
      </li>
    ))}
  </ol>
</Slide>

<style>
  .grid {
    list-style: none;
    margin-top: 4rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4rem 3.5rem;
  }

  .role {
    position: relative;
    flex: 0 1 calc((100% - 7rem) / 3);
    min-width: 15rem;
  }

  .label {
    position: relative;
    display: inline-flex;
    align-items: flex-end;
    gap: 0.3rem;
    margin-bottom: 0.9rem;
    min-height: 1.6rem;
  }

  .ring {
    position: absolute;
    left: -0.8rem;
    top: -0.55rem;
    width: calc(100% + 1.6rem);
    height: calc(100% + 1.1rem);
    stroke-width: 1.6;
  }

  .swoosh {
    position: absolute;
    left: -0.3rem;
    bottom: -0.55rem;
    width: calc(100% + 0.6rem);
    height: 0.6rem;
    stroke-width: 1.6;
  }

  .arrow {
    margin-bottom: -1rem;
    stroke-width: 1.8;
  }

  /* tick-ended measuring bar down the card's left edge */
  .role.mark-bar {
    padding-left: 1.5rem;
  }

  .bar {
    position: absolute;
    left: 0.25rem;
    top: 0.2rem;
    bottom: 0.2rem;
    border-left: 1.6px solid var(--color-accent);
  }

  .bar::before,
  .bar::after {
    content: '';
    position: absolute;
    left: -0.45rem;
    width: 0.8rem;
    border-top: 1.6px solid var(--color-accent);
  }

  .bar::before { top: 0; }
  .bar::after { bottom: 0; }

  .company {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .meta {
    margin-top: 0.3rem;
    font-size: var(--text-base);
  }

  .dates {
    margin-top: 0.15rem;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .desc {
    margin-top: 0.8rem;
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  /* links in descriptions (markup from set:html, hence :global) */
  .desc :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 3px;
  }

  .desc :global(a:hover) {
    color: var(--color-accent);
  }

  @media (max-width: 960px) {
    .role {
      flex-basis: calc((100% - 3.5rem) / 2);
    }
  }

  @media (max-width: 640px) {
    .grid {
      margin-top: 3rem;
      gap: 2.75rem;
    }

    .role {
      flex-basis: 100%;
      min-width: 0;
    }

    .company {
      font-size: 1.15rem;
    }
  }
</style>
